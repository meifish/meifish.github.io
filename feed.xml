---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>{{ site.title | xml_escape }}</title>
  <link>{{ '/' | absolute_url }}</link>
  <atom:link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/rss+xml" />
  <description>{{ site.description | xml_escape }}</description>
  <language>en</language>
  {% if site.data.posts.first %}<lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>{% endif %}
  {% for post in site.data.posts %}
  {% assign link = '/posts/' | append: post.folder | append: '/' | absolute_url %}
  <item>
    <title>{{ post.title | xml_escape }}</title>
    <link>{{ link }}</link>
    <guid isPermaLink="true">{{ link }}</guid>
    <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
    <description>{% if post.cover %}&lt;p&gt;&lt;img src="{{ link }}{{ post.cover }}" alt="" /&gt;&lt;/p&gt;{% endif %}&lt;p&gt;{{ post.summary | xml_escape }}&lt;/p&gt;&lt;p&gt;&lt;a href="{{ link }}"&gt;Read the interactive post&lt;/a&gt;&lt;/p&gt;</description>
  </item>
  {% endfor %}
</channel>
</rss>
